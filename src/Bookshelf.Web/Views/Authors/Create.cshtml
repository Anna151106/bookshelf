@model AuthorFormViewModel
@{
    ViewData["Title"] = "Новий автор";
}

<h1 class="h3 mb-3">Новий автор</h1>

<form asp-action="Create" method="post" class="col-lg-8">
    <partial name="_Form" model="Model" />
    <button type="submit" class="btn btn-primary">Зберегти</button>
    <a class="btn btn-link" asp-action="Index">Скасувати</a>
</form>
