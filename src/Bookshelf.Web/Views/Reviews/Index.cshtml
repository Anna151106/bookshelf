@model IReadOnlyList<ReviewDto>
@{
    ViewData["Title"] = "Відгуки";
}

<h1 class="h3 mb-3">Відгуки</h1>

@if (Model.Count == 0)
{
    <p class="text-muted">Відгуків ще немає.</p>
}
else
{
    <div class="list-group">
        @foreach (var review in Model)
        {
            <a class="list-group-item list-group-item-action" asp-action="Details" asp-route-id="@review.Id">
                <div class="d-flex justify-content-between flex-wrap gap-2">
                    <div>
                        <strong>@review.ReaderName</strong>
                        <span class="rating ms-2">@ViewHelpers.Stars(review.Rating)</span>
                    </div>
                    <small class="text-muted">@review.CreatedAt.ToLocalTime().ToString("d MMMM yyyy")</small>
                </div>
                <div class="small text-muted">«@review.BookTitle»</div>
            </a>
        }
    </div>
}
