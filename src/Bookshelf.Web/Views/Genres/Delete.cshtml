@model GenreDetailsDto
@{
    ViewData["Title"] = "Видалення жанру";
}

<h1 class="h3 mb-3">Видалити жанр?</h1>

<div class="card mb-3 col-lg-6">
    <div class="card-body">
        <h2 class="h5 card-title">@Model.Name</h2>
        @if (Model.Books.Count > 0)
        {
            <div class="alert alert-warning mb-0">
                У цьому жанрі є книги (@Model.Books.Count), тому його не можна видалити.
            </div>
        }
        else
        {
            <p class="card-text text-muted mb-0">Цю дію не можна скасувати.</p>
        }
    </div>
</div>

<form asp-action="Delete" method="post">
    <button type="submit" class="btn btn-danger" disabled="@(Model.Books.Count > 0)">Видалити</button>
    <a class="btn btn-link" asp-action="Details" asp-route-id="@Model.Id">Скасувати</a>
</form>
