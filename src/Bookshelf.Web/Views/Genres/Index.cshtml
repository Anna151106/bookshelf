@model IReadOnlyList<GenreListDto>
@{
    ViewData["Title"] = "Жанри";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Жанри</h1>
    <a class="btn btn-primary" asp-action="Create">Додати жанр</a>
</div>

@if (Model.Count == 0)
{
    <p class="text-muted">Жанрів ще немає.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Назва</th>
                    <th class="text-end">Книг</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var genre in Model)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@genre.Id">@genre.Name</a></td>
                        <td class="text-end">@genre.BookCount</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@genre.Id">Редагувати</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@genre.Id">Видалити</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
